# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni o'zgartiring:
#   cp .env.example .env

# Production uchun 0 (sinov uchun 1)
DJANGO_DEBUG=0

# Uzun tasodifiy kalit. Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit-yozing

# Sayt manzili (PythonAnywhere: LOGIN.pythonanywhere.com)
DJANGO_ALLOWED_HOSTS=LOGIN.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://LOGIN.pythonanywhere.com

# Saytda ko'rinadigan nomlar
SITE_TITLE=Talabalar ma'lumotnomasi
ORG_NAME=Universitet nomi
